{
  "rewrites": [
    {
      "source": "/api/auth/google/callback",
      "destination": "https://x-yokc.onrender.com/api/auth/google/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "https://x-yokc.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
